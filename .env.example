# ==============================================================================
# TRADING INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or real credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
APP_HOST=0.0.0.0
APP_PORT=8000

# TimescaleDB / PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@localhost:5432/trading_db

# Redis Cache & Message Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# Market Data Ingestion
DEFAULT_DATA_PROVIDER=coinbase_ws
DEFAULT_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
STALE_DATA_THRESHOLD_SECONDS=15.0
WS_RECONNECT_INITIAL_DELAY_SECONDS=1.0
WS_RECONNECT_MAX_DELAY_SECONDS=30.0
WS_MAX_RECONNECT_ATTEMPTS=10
PING_INTERVAL_SECONDS=20.0
PING_TIMEOUT_SECONDS=10.0

# Candle Engine
PRIMARY_TIMEFRAME=1m
ENABLED_TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Risk Engine Limits (Defaults)
MAX_RISK_PER_TRADE_PCT=0.01
MAX_PORTFOLIO_EXPOSURE_PCT=0.20
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_LIMIT_PCT=0.10
CIRCUIT_BREAKER_STALE_SECS=30.0
